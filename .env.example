# Copy to .env.local (development). Never commit real values.
# Classes: PUBLIC = sent to browsers; SERVER-ONLY = never bundled; SECRET = server-only, never log or commit.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser; all others are server-only.

# development | staging | production  (deployment tier, distinct from NODE_ENV)
APP_ENV=development

# Public (browser-safe)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public (browser-safe — a measurement/container/pixel id, not a credential). Stage 4, Phase 5.
# All optional and independent: unset means that provider's script never loads (never a fake id).
# See src/lib/analytics-config.ts.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_CONTAINER_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Only meaningful together with NEXT_PUBLIC_GOOGLE_ADS_ID; the one conversion action this codebase maps to (contact intent).
NEXT_PUBLIC_GOOGLE_ADS_CONTACT_CONVERSION_LABEL=
# The <meta name="google-site-verification"> content Search Console issues for this property.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# SECRET, server-only. MongoDB connection string (mongodb://127.0.0.1:27017/smash, or a mongodb+srv:// Atlas URI).
# Required for database access, db:migrate and db:seed, and in staging/production (startup fails without it).
MONGODB_URI=
# SERVER-ONLY (not secret). Optional: database name; defaults to the one in MONGODB_URI's path.
MONGODB_DB=
# SERVER-ONLY (not secret). Optional: extra hosts allowed to serve media, e.g. cdn.example.com,*.img.example.com
MEDIA_ALLOWED_HOSTS=

# SECRET, server-only. Bearer token for the admin content-management API (/api/admin/**).
# Unset disables the admin API entirely (every admin request gets a safe 500). At least 32
# random characters, e.g. `openssl rand -base64 32`. Never reuse across environments.
ADMIN_API_TOKEN=
# SECRET, server-only, optional. A second bearer token for the "Content Editor" role (Stage 5,
# Phase 1): can create/edit content but cannot publish it or touch Site Settings — an
# Administrator (the token above) must do those. Leave unset to keep only the Administrator role.
# Must differ from ADMIN_API_TOKEN. Same generation method, at least 32 random characters.
CMS_EDITOR_API_TOKEN=

# SECRET, server-only. Signs the CRM admin login session cookie (CRM Phase 2, /admin/**).
# Unset disables CRM admin login entirely (every attempt gets a safe 500). At least 32
# random characters, e.g. `openssl rand -base64 32`. Must differ from ADMIN_API_TOKEN.
ADMIN_SESSION_SECRET=
# SERVER-ONLY, seed-only (not read at request time). The initial CRM admin account's email,
# used once by `npm run db:seed-admin`. Must be set together with ADMIN_PASSWORD, or neither.
ADMIN_EMAIL=
# SECRET, seed-only. The initial CRM admin account's password — used once to create the account
# (only its hash is stored) then safe to remove from this file. At least 12 characters.
ADMIN_PASSWORD=

# Logging: debug | info | warn | error
LOG_LEVEL=info

# SECRET, server-only. Cloudinary account used for the Home showcase video. Only the cloud name is used at render time;
# the key and secret are for uploading.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Public ID of the showcase video in Cloudinary (e.g. smash-website/showcase). Unset = the local /media/home/showcase.mp4 is used.
CLOUDINARY_SHOWCASE_VIDEO=
