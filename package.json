{
  "name": "smash-international-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/migrate.ts",
    "db:import-home": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/import-home-design.ts",
    "db:import-careers": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/import-careers-design.ts",
    "db:audit-process-copy": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/audit-service-process-copy.ts",
    "db:audit-client-budgets": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/audit-client-budgets.ts",
    "db:update-service-seo-copy": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/update-service-seo-copy.ts",
    "db:update-process-copy": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/update-service-process-copy.ts",
    "db:sync-team": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/sync-team.ts",
    "db:seed": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/seed.ts",
    "db:seed-admin": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/seed-admin.ts",
    "seo:audit": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/seo-audit.ts",
    "seo:check-domain": "node --import tsx scripts/check-domain.ts",
    "db:dev": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/dev-db.ts"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lucide-react": "^1.52.0",
    "mongodb": "^7.6.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "three": "^0.170.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
